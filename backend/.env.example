# RiskShield AI Production Configuration
ENVIRONMENT=production
PROJECT_NAME=RiskShield AI
API_V1_STR=/api/v1

# Database Configuration
DATABASE_URL=postgresql+asyncpg://riskshield_user:riskshield_password@localhost:5432/riskshield_db
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=riskshield_user
POSTGRES_PASSWORD=riskshield_password
POSTGRES_DB=riskshield_db

# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017/riskshield

# Redis & Celery
REDIS_HOST=localhost
REDIS_PORT=6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# JWT & Authentication
SECRET_KEY=super_secret_riskshield_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=2

# CORS (JSON Array or Comma-Separated List)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# External AI Services
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
